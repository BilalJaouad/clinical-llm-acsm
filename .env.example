# URL of your BioMistral-7B inference endpoint
# e.g. a Hugging Face Inference Endpoint, or a self-hosted TGI/vLLM server
BIOMISTRAL_API_URL=https://api-inference.huggingface.co/models/BioMistral/BioMistral-7B

# API key / token for the endpoint above
BIOMISTRAL_API_KEY=your_api_key_here

# "hf" for a Hugging Face style text-generation endpoint (default),
# "openai" for an OpenAI-compatible /chat/completions style endpoint
BIOMISTRAL_API_MODE=hf

# Optional model name, only used when BIOMISTRAL_API_MODE=openai
BIOMISTRAL_MODEL_NAME=BioMistral-7B

# Generation settings (kept small/low to save tokens and keep answers short)
MAX_NEW_TOKENS=250
TEMPERATURE=0.3
REQUEST_TIMEOUT=30
